// Development environment for GitHub Codespaces (and VS Code Dev Containers).
// A codespace created from this repository is the host machine for the pipeline:
// it runs Nexus, the self-hosted GitHub Actions runner and the deployed app container.
{
  "name": "devops-nexus-pipeline",

  // Plain Debian 12. (The devcontainers "java" image carries a Yarn apt source whose
  // signing key no longer verifies, which makes the Docker feature's apt-get update fail.)
  "image": "mcr.microsoft.com/devcontainers/base:1-bookworm",

  "features": {
    // JDK 21, matching the app's Java version.
    "ghcr.io/devcontainers/features/java:1": { "version": "21" },
    // A Docker engine inside the codespace, for Nexus, image builds and the deployed app.
    // Its data (images, containers, the nexus-data volume) is kept when the codespace stops.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    // SSH server, so the codespace can be driven from a local terminal with `gh codespace ssh`.
    "ghcr.io/devcontainers/features/sshd:1": {}
  },

  // Nexus (1.2 GB) + a Maven build + the app need about 3 GB; 8 GB is the 2-core machine.
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },

  // Restart the self-hosted runner whenever the codespace starts. (Nexus restarts by itself:
  // its container has restart: unless-stopped.)
  "postStartCommand": "bash .devcontainer/start-runner.sh",

  "forwardPorts": [8080, 8081],
  "portsAttributes": {
    "8080": { "label": "App (deployed container)" },
    "8081": { "label": "Nexus web UI" },
    "8082": { "label": "Nexus Docker registry", "onAutoForward": "ignore" }
  }
}
