# Copy to .env (same folder) and choose passwords. .env is git-ignored.
# setup-nexus.sh reads these values.

# New password for the Nexus "admin" account (replaces the generated one on first setup).
NEXUS_ADMIN_PASSWORD=change-me-admin

# Password for the "ci" user that GitHub Actions uses. The same value goes into
# the GitHub secret NEXUS_PASSWORD (and "ci" into NEXUS_USER).
NEXUS_CI_PASSWORD=change-me-ci
